{%- macro get_route_config() -%}
{%- set route_rules = [] -%}
{%- set route_rule_sets = [] -%}

{# Rule Sets #}
{# custom-internal-rule-set #}
{%- if sing_box_custom_internal_rule_set_rules | length > 0 -%}
    {%- set _ = route_rule_sets.append({
        "tag": sing_box_custom_internal_rule_set,
        "type": "inline",
        "format": "source",
        "rules": sing_box_custom_internal_rule_set_rules
    }) -%}
{%- endif -%}

{# custom-direct-rule-set #}
{%- if sing_box_custom_direct_rule_set_rules | length > 0 -%}
    {%- set _ = route_rule_sets.append({
        "tag": sing_box_custom_direct_rule_set,
        "type": "inline",
        "format": "source",
        "rules": sing_box_custom_direct_rule_set_rules
    }) -%}
{%- endif -%}

{# https://github.com/MetaCubeX/meta-rules-dat/tree/sing #}
{%- for item in sing_box_remote_rule_sets -%}
    {%- set path = item.path -%}
    {%- set _ext = path.split('.') | last -%}
    {%- set _tag = path | replace('/', '-') | replace('.' ~ _ext, '') -%}
    {%- set _format = 'binary' if _ext == 'srs' else 'source' -%}
    {%- set _ = route_rule_sets.append({
        "tag": _tag,
        "type": "remote",
        "format": _format,
        "url": sing_box_remote_rule_set_url_prefix ~ path,
        "update_interval": sing_box_remote_rule_set_update_interval
    }) -%}
{%- endfor -%}

{# Rules #}
{# Custom Rejected Rules #}
{# outbound REJECT/DIRECT defined in templates/includes/outbounds.j2 #}
{%- set _custom_rejected_ips = (sing_box_custom_rejected_ip4 | default([], true)) + (sing_box_custom_rejected_ip6 | default([], true)) -%}
{%- if _custom_rejected_ips | length > 0 -%}
    {%- set _ = route_rules.append({"action": "route", "ip_cidr": _custom_rejected_ips, "outbound": "REJECT"}) -%}
{%- endif -%}

{# Custom Bypassed (Direct) Rules #}
{%- set _custom_bypassed_ips = (sing_box_custom_bypassed_ip4 | default([], true)) + (sing_box_custom_bypassed_ip6 | default([], true)) -%}
{%- if _custom_bypassed_ips | length > 0 -%}
    {%- set _ = route_rules.append({"action": "route", "ip_cidr": _custom_bypassed_ips, "outbound": "DIRECT"}) -%}
{%- endif -%}

{# Basic Rules #}
{%- set _ = route_rules.extend(sing_box_basic_rules) -%}

{# Custom Rules #}
{%- if sing_box_custom_internal_rule_set_rules | length > 0 -%}
    {%- set _ = route_rules.append({"action": "route", "rule_set": [sing_box_custom_internal_rule_set], "outbound": "DIRECT"}) -%}
{%- endif -%}

{%- if sing_box_custom_direct_rule_set_rules | length > 0 -%}
    {%- set _ = route_rules.append({"action": "route", "rule_set": [sing_box_custom_direct_rule_set], "outbound": "DIRECT"}) -%}
{%- endif -%}

{# Filtering Rules #}
{%- set _ = route_rules.extend(sing_box_filtering_rules) -%}

{%- set route_config = {
    "rules": route_rules,
    "rule_set": route_rule_sets,
    "final": sing_box_route_final,
    "auto_detect_interface": sing_box_route_auto_detect_interface,
    "default_domain_resolver": sing_box_route_default_domain_resolver
} -%}
{{ route_config | ansible.builtin.to_json }}
{%- endmacro -%}
