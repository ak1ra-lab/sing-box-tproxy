{%- macro get_outbounds_config() -%}
{%- set outbounds_config = [] -%}

{# Basic Outbounds #}
{%- set _ = outbounds_config.extend([
    {"tag": "DIRECT", "type": "direct"},
    {"tag": "REJECT", "type": "block"}
]) -%}

{# Add Proxy Groups to Config and populate their outbounds #}
{%- for group in sing_box_proxy_groups -%}
    {%- set _group_outbounds = group.outbounds -%}
    {%- for item in sing_box_region_groups -%}
        {%- set _ = _group_outbounds.append(item.tag ~ sing_box_selfhost_group_suffix) -%}
    {%- endfor -%}
    {%- for item in sing_box_region_groups -%}
        {%- set _ = _group_outbounds.append(item.tag ~ sing_box_auto_group_suffix) -%}
    {%- endfor -%}
    {%- for item in sing_box_region_groups -%}
        {%- set _ = _group_outbounds.append(item.tag ~ sing_box_selector_group_suffix) -%}
    {%- endfor -%}

    {%- set _ = outbounds_config.append({
        "tag": group.tag,
        "type": group.type,
        "outbounds": _group_outbounds
    }) -%}
{%- endfor -%}

{# Add Selfhost Groups to Config (selector, selfhost nodes only) #}
{# Combined filter: matches proxies that are BOTH selfhost AND in the target region.
   Uses two zero-width lookaheads so order of terms in the tag does not matter. #}
{%- for item in sing_box_region_groups -%}
    {%- set combined_filter = "(?=.*(?:" + sing_box_selfhost_tag_pattern + "))(?=.*(?:" + item.regex + "))" -%}
    {%- set _ = outbounds_config.append({
        "tag": item.tag ~ sing_box_selfhost_group_suffix,
        "type": "selector",
        "outbounds": [],
        "filter": combined_filter
    }) -%}
{%- endfor -%}

{# Add Auto Groups to Config (urltest, excludes selfhost nodes) #}
{%- for item in sing_box_region_groups -%}
    {%- set _ = outbounds_config.append({
        "tag": item.tag ~ sing_box_auto_group_suffix,
        "type": "urltest",
        "outbounds": [],
        "filter": item.regex,
        "exclude": sing_box_selfhost_tag_pattern
    }) -%}
{%- endfor -%}

{# Add Selector Groups to Config (selector, excludes selfhost nodes) #}
{%- for item in sing_box_region_groups -%}
    {%- set _ = outbounds_config.append({
        "tag": item.tag ~ sing_box_selector_group_suffix,
        "type": "selector",
        "outbounds": [],
        "filter": item.regex,
        "exclude": sing_box_selfhost_tag_pattern
    }) -%}
{%- endfor -%}

{{ outbounds_config | ansible.builtin.to_json }}
{%- endmacro -%}
