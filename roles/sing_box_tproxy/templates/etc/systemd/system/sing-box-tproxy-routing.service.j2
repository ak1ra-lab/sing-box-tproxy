# Generated by Ansible - DO NOT EDIT MANUALLY
# /etc/systemd/system/sing-box-tproxy-routing.service
#
# Adds the ip rule (policy routing) and ip route (local default) entries
# needed for TPROXY to intercept locally-generated packets.
#
# Equivalent manual commands:
#   ip -4 rule add fwmark {{ sing_box_proxy_mark }} lookup {{ sing_box_proxy_route_table }}
#   ip -4 route add local default dev {{ ansible_default_ipv4.interface }} table {{ sing_box_proxy_route_table }}
{% if _sing_box_enable_ipv6 %}
#   ip -6 rule add fwmark {{ sing_box_proxy_mark }} lookup {{ sing_box_proxy_route_table }}
#   ip -6 route add local default dev {{ ansible_default_ipv6.interface }} table {{ sing_box_proxy_route_table }}
{% endif %}

[Unit]
Description=sing-box TPROXY routing rules (ip rule + ip route)
Documentation=https://github.com/ak1ra-lab/sing-box-tproxy
Wants=network-online.target sing-box.service
After=network-online.target sing-box.service

[Service]
Type=oneshot
LogNamespace={{ sing_box_log_namespace }}
RemainAfterExit=yes

# IPv4: remove any stale rules/routes before re-adding (idempotent)
ExecStartPre=-/usr/bin/ip -4 route del local default table {{ sing_box_proxy_route_table }}
ExecStartPre=-/usr/bin/ip -4 rule del fwmark {{ sing_box_proxy_mark }} lookup {{ sing_box_proxy_route_table }}
{% if _sing_box_enable_ipv6 %}
# IPv6: remove any stale rules/routes before re-adding (idempotent)
ExecStartPre=-/usr/bin/ip -6 route del local default table {{ sing_box_proxy_route_table }}
ExecStartPre=-/usr/bin/ip -6 rule del fwmark {{ sing_box_proxy_mark }} lookup {{ sing_box_proxy_route_table }}
{% endif %}

# IPv4: add routing policy rule and local default route
ExecStart=/usr/bin/ip -4 rule add fwmark {{ sing_box_proxy_mark }} lookup {{ sing_box_proxy_route_table }}
ExecStart=/usr/bin/ip -4 route add local default dev {{ ansible_default_ipv4.interface }} table {{ sing_box_proxy_route_table }}
{% if _sing_box_enable_ipv6 %}
# IPv6: add routing policy rule and local default route
ExecStart=/usr/bin/ip -6 rule add fwmark {{ sing_box_proxy_mark }} lookup {{ sing_box_proxy_route_table }}
ExecStart=/usr/bin/ip -6 route add local default dev {{ ansible_default_ipv6.interface }} table {{ sing_box_proxy_route_table }}
{% endif %}

# Remove routing rules/routes on stop (ignore errors if already absent)
ExecStop=-/usr/bin/ip -4 route del local default table {{ sing_box_proxy_route_table }}
ExecStop=-/usr/bin/ip -4 rule del fwmark {{ sing_box_proxy_mark }} lookup {{ sing_box_proxy_route_table }}
{% if _sing_box_enable_ipv6 %}
ExecStop=-/usr/bin/ip -6 route del local default table {{ sing_box_proxy_route_table }}
ExecStop=-/usr/bin/ip -6 rule del fwmark {{ sing_box_proxy_mark }} lookup {{ sing_box_proxy_route_table }}
{% endif %}

[Install]
WantedBy=multi-user.target
