---
# acme-dns registration credentials for {{ inventory_hostname }}
# Registered: {{ now(utc=True, fmt='%Y-%m-%dT%H:%M:%SZ') }}
# DO NOT EDIT: auto-generated by the roles/acme_dns_register role.
#
# CNAME record(s) required (add once, then permanent):
{% for _domain in acme_dns_register_acme_domains %}
#   _acme-challenge.{{ _domain }}.  CNAME  {{ _acme_dns_fulldomain }}.
{% endfor %}

acme_dns_register_username: "{{ acme_dns_register_username }}"
acme_dns_register_password: "{{ acme_dns_register_password }}"
acme_dns_register_subdomain: "{{ acme_dns_register_subdomain }}"
acme_dns_register_server_url: "{{ acme_dns_register_server_url }}"
